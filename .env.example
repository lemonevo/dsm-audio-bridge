# 复制为 .env 后按实际值填写（.env 已在 .gitignore，不进仓库）。

# 音乐目录的 WebDAV 地址（OpenList / Alist / 群晖 WebDAV 均可）
WEBDAV_URL=http://127.0.0.1:5244/dav/Music
# WebDAV 账号与密码
WEBDAV_USER=admin
WEBDAV_PASS=

# DS Music 里填写的账号密码（本服务不校验，只用于推导 sid/token）
DSM_ACCOUNT=admin
DSM_PASSWORD=

# 可选
# LIBRARY_NAME=Music
# ARTIST_IMAGE_PROXY=
# RESCAN_INTERVAL=120